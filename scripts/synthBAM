#!/usr/bin/env bash
set -e -o pipefail

TMPDIR_ROOT=$TMPDIR
REFERENCE=human_g1k_v37.fasta
INDEX=
SHAREDREF=
SAMPLE=
STATSPATH=
PHASE_REGION=
PHASE_VCF=
PHASE_SAMPLE=
ALIGNER=bwa-mem3
PRESET=bcbio

COVERAGE=20
FRAGMEAN=400
FRAGSD=121
LENGTH=150
PROFILE=HS25
SAMPLES=1

function add_SQ_HP_tag() {
    # Extract haplotype sequence ID from read name "seq-0-0-..." to 0_0 or "seq-1-1-..." to 1_1 and set SQ to permit
    # downstream splitting of reads by haplotype. Set HP to 1 or 2 based on the parity of the last haplotype ID.
    awk 'BEGIN { FS = OFS = "\t" } /^@/ { print; next } { split($1, h, "-"); print $0, "SQ:Z:" h[2] "_" h[3], "HP:i:" (h[3] % 2) + 1 }'
}

function add_SQ_tag() {
    awk 'BEGIN { FS = OFS = "\t" } /^@/ { print; next } { split($1, h, "-"); print $0, "SQ:Z:" h[2] "_" h[3] }'
}

usage()
{
    cat << EOF
usage: $(basename "$0") [options] IN_FASTA OUT_BAM

Generate synthetic BAMs for single variant and specified zygosity

Options:
  -h            Print this message
  -R FASTA      Path to reference file, default: $REFERENCE
  -x PREFIX     Path prefix of the aligner index, default: reference file
  -S FASTA      Reference file already in shared memory (bwa only), default: undefined
  -c integer    Coverage for every sequence in FASTA (i.e. for each haplotype present), default: $COVERAGE
  -m float      Mean fragment size, default: $FRAGMEAN
  -s float      Standard deviation of fragment size, default: $FRAGSD
  -t DIRECTORY  Root for temporary directory, default: $TMPDIR_ROOT
  -l integer    Read length, default: $LENGTH
  -p string     ART sequencer profile, default: $PROFILE
  -i integer    Number of samples in output SAM/BAM, default: $SAMPLES
  -n string     Sample name, default: undefined
  -j FILE       NPSV stats file for GC normalized coverage, default: undefined
  -g FILE       Path to gnomAD coverage file, default: undefined
  -v FILE       Phased VCF (if specified, phasing region and phasing sample must be specified), default: undefined
  -r string     Region for phasing, default: undefined
  -N string     Sample in phased VCF, default: undefined
  -a string     Aligner to use, one of "bwa-mem3", "bwa" or "novo", default: $ALIGNER
  -b string     BWA parameter preset, "bcbio" (-c 250 -M) or "nygc" (-Y -K 100000000, as used for the NYGC 1000 Genomes
                high-coverage data), default: $PRESET
EOF
}

while getopts "hR:x:S:c:m:s:t:l:p:z:i:p:n:j:g:r:v:N:a:b:" Option
do
    case $Option in
        R)
            REFERENCE=$OPTARG
            ;;
        x)
            INDEX=$OPTARG
            ;;
        S)
            SHAREDREF=$OPTARG
            ;;
        c)
            COVERAGE=$OPTARG
            ;;
        m)
            FRAGMEAN=$OPTARG
            ;;
        s)
            FRAGSD=$OPTARG
            ;;
        t)
            TMPDIR_ROOT=$OPTARG
            ;;
        l)
            LENGTH=$OPTARG
            ;;
        p)
            PROFILE=$OPTARG
            ;;
        z)
            ZYGOSITY=$OPTARG
            ;;
        i)
            SAMPLES=$OPTARG
            ;;
        n)
            SAMPLE=$OPTARG
            ;;
        j)
            STATSPATH=$OPTARG
            ;;
        r)
            PHASE_REGION=$OPTARG
            ;;
        v)
            PHASE_VCF=$OPTARG
            ;;
        N)
            PHASE_SAMPLE=$OPTARG
            ;;
        a)
            ALIGNER=$OPTARG
            ;;
        b)
            PRESET=$OPTARG
            ;;
        h)
            usage
            exit 0
            ;;
        ?)
            usage
            exit 85
            ;;
    esac
done

shift $((OPTIND-1))
if [[ $# -ne 2 ]]; then
    >&2 echo "Error: Missing positional arguments"
    >&2 usage
    exit 1
fi

FASTA=$1
OUTBAM=$2

if [[ ! -e "$FASTA" ]]; then
    >&2 echo "Error: Input FASTA file $FASTA does not exist"
    >&2 usage
    exit 1
fi

case "$ALIGNER" in
    bwa-mem3|bwa|novo)
        ;;
    *)
        >&2 echo "Error: Unknown aligner $ALIGNER"
        >&2 usage
        exit 1
        ;;
esac

case "$PRESET" in
    bcbio)
        BWA_PRESET_ARGS=(-c 250 -M)
        ;;
    nygc)
        BWA_PRESET_ARGS=(-Y -K 100000000)
        ;;
    *)
        >&2 echo "Error: Unknown BWA parameter preset $PRESET"
        >&2 usage
        exit 1
        ;;
esac

if [[ -n "$PHASE_VCF" && (-z "$PHASE_REGION" || -z "$PHASE_SAMPLE") ]]; then
    >&2 echo "Error: Phase region and sample must be specified with phasing VCF"
    >&2 usage
    exit 1
fi

TMPDIR=$(mktemp -d --tmpdir="$TMPDIR_ROOT") || exit 1
trap "rm -rf $TMPDIR" 0

cp "$FASTA" "${OUTBAM/%bam/synth.fasta}"

# If the aligner index is not defined, assume it is alongside the reference
if [[ -z $INDEX ]]; then
    INDEX="$REFERENCE"
fi

# If shared memory reference is not defined, use index files. bwa-mem3 always uses the index path, attaching to the
# index in shared memory if one with the same basename is present.
if [[ -z $SHAREDREF ]]; then
    SHAREDREF="$INDEX"
fi

for (( s=1; s<=SAMPLES; s++ ))
do
    if [[ -z "$SAMPLE" ]]; then
        SM="synth${s}"
    else
        SM="$SAMPLE"
    fi
    # Generate synthetic reads reads1.fq and reads2.fq. art_illumina use time in seconds for seed which can result in
    # identical seeds for data. SYNTH_SEED can be set to fix the seed (e.g. for testing).
    READS_PREFIX=$TMPDIR/reads.synth${s}
    art_illumina -q -i "$FASTA" -o "$READS_PREFIX" -sam -na -ss "$PROFILE" -l "$LENGTH" -f "$COVERAGE" -p -m "$FRAGMEAN" -s "$FRAGSD" -sp -rs ${SYNTH_SEED:-$(od -An -tu4 -N4 /dev/urandom)} 1>&2

    >&2 echo "Generating aligned BAM"
    # Generate synthetic aligned BAM using minimal, but representative, pipeline
    # This pipeline should be modified to make the simulated pipeline similar to the
    # the pipeline used with the actual data. The BAM is consumed immediately (e.g. split by haplotype), so minimal
    # compression is sufficient.
    ALIGNEDBAM=$TMPDIR/aligned${s}.bam
    READ_GROUP="@RG\tID:synth${s}\tSM:${SM}\tLB:synth${s}\tPL:illumina\tPU:ART"

    if [[ "$ALIGNER" == "novo" ]]; then
        # There doesn't appear to be a way to force the index to remain in memory
        novoalign -d "${REFERENCE}.novo" -F STDFQ -t 400 --Q2Off -c 10 -i PE "${FRAGMEAN%.*},${FRAGSD%.*}" \
            -o SAM "$READ_GROUP" \
            -f "${READS_PREFIX}1.fq" "${READS_PREFIX}2.fq"
    elif [[ "$ALIGNER" == "bwa-mem3" ]]; then
        # --compat=bwa-mem produces records identical to bwa (other than adding the MQ tag)
        bwa-mem3 mem --compat=bwa-mem "${BWA_PRESET_ARGS[@]}" -v 1 -I "${FRAGMEAN},${FRAGSD}" \
            -R "$READ_GROUP" \
            "$INDEX" \
            "${READS_PREFIX}1.fq" "${READS_PREFIX}2.fq"
    else
        bwa mem "${BWA_PRESET_ARGS[@]}" -v 1 -I "${FRAGMEAN},${FRAGSD}" \
            -R "$READ_GROUP" \
            "$SHAREDREF" \
            "${READS_PREFIX}1.fq" "${READS_PREFIX}2.fq"
    fi | \
    samblaster -q -M --addMateTags | \
    if [[ -n "$PHASE_VCF" ]]; then
        add_SQ_tag
    else
        add_SQ_HP_tag
    fi | \
    samtools sort -l 1 -m 512M -T "$TMPDIR/sort${s}" --write-index -o "${ALIGNEDBAM}##idx##${ALIGNEDBAM}.bai" -

    if [[ -n "$PHASE_VCF" ]]; then
        >&2 echo "Phasing with variants in ${PHASE_REGION}"
        whatshap haplotag \
            --tag-supplementary \
            --ignore-read-groups \
            --reference $REFERENCE \
            --regions $PHASE_REGION \
            --sample $PHASE_SAMPLE \
            -o "${ALIGNEDBAM/%bam/phase.bam}" \
            $PHASE_VCF \
            $ALIGNEDBAM
        mv "${ALIGNEDBAM/%bam/phase.bam}" $ALIGNEDBAM
        samtools index $ALIGNEDBAM
    fi

    # Cleanup files generated by ART
    rm -f "${READS_PREFIX}.sam" "${READS_PREFIX}1.fq" "${READS_PREFIX}2.fq" "${READS_PREFIX}1.aln" "${READS_PREFIX}2.aln"
done

if [[ "$SAMPLES" -gt 1 ]]; then
    # Combine all of the individual BAM files
    >&2 echo "Generating aligned BAM files with replicates"
    samtools merge -f -l 1 --write-index -o "${OUTBAM}##idx##${OUTBAM}.bai" $(seq 1 "$SAMPLES" | xargs printf " $TMPDIR/aligned%d.bam")
else
    mv "$TMPDIR/aligned1.bam" "$OUTBAM"
    mv "$TMPDIR/aligned1.bam.bai" "$OUTBAM.bai"
fi
>&2 echo "Completed generating synthetic data"
